```python
import tkinter as tk
from gpiozero import LED


# Connect each room's light to its GPIO pin
room_lights = {
    "Living Room": LED(14),  # Living room light
    "Bathroom": LED(15),     # Bathroom light
    "Closet": LED(18),       # Closet light
}


# Turn on the selected room's light
def change_light(room_name):

    # Check each room and control its light
    for room, light in room_lights.items():
        light.value = int(room == room_name)


# Turn off all lights and close the program
def exit_program():

    # Turn off each light and release its GPIO pin
    for light in room_lights.values():
        light.off()
        light.close()

    # Close the application window
    window.quit()
    window.destroy()


# Create the main application window
window = tk.Tk()

# Set the window title and size
window.title("Room Light Controller")
window.geometry("340x260")

# Stop the user from changing the window size
window.resizable(width=False, height=False)


# Show the heading at the top of the window
tk.Label(
    window,
    text="Choose a room",
    font=("Arial", 16, "bold"),
).pack(pady=(18, 10))


# Store the room selected by the user
choice = tk.StringVar(window)


# Create a radio button for each room
for room_name in room_lights:
    tk.Radiobutton(
        window,
        text=room_name,
        variable=choice,
        value=room_name,
        command=lambda room=room_name: change_light(room),
        font=("Arial", 12),
    ).pack(anchor="w", padx=85, pady=3)


# Add a button to exit the program
tk.Button(
    window,
    text="Exit",
    command=exit_program,
).pack(pady=18)


# Turn off the lights when the user closes the window
window.protocol("WM_DELETE_WINDOW", exit_program)


# Keep the window running until the user closes it
window.mainloop()
```
